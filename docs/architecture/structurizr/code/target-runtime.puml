@startuml
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam shadowing false
title TARGET DESIGN ONLY: planned runtime modules and contracts
interface "AgentAdapter" as adapter {
 probe() : CapabilitySet
 start(JobRequest, ExecutionPolicy) : Attempt
 resume(SessionRef, JobRequest, Policy) : Attempt
 cancel(AttemptRef)
 events(AttemptRef) : AgentEvent stream
}
class "mcp-tools.mjs / ipc-client.mjs" as bridge {
 dispatch(tool, arguments, trustedConnection)
 legacy aliases return JobHandle
}
class "job-api.mjs" as api {
 submit(request) : JobHandle
 get(jobId) : JobSnapshot
 readEvents(jobId, cursor) : EventPage
 cancel(jobId) : JobSnapshot
 resume(jobId, prompt, mode) : JobHandle
}
class "scheduler.mjs" as scheduler {
 reserve host slot + recorded session
 reject delegated recursion
}
class "permissions.mjs" as policy {
 enforce(CapabilitySet, mode)
 decide(PermissionRequest, explicitDecision)
 fail closed on unsupported enforcement
}
class "process-supervisor.mjs" as process {
 launch(executable, argv, cwd, policy)
 cancelOwnedTree(AttemptRef)
}
class "adapters/{claude,codex,grok,cline}.mjs" as implementations
class "events.mjs" as events {
 redactAndAppend(AgentEvent)
 page(jobId, cursor) : EventPage
}
class "job-store.mjs" as store {
 acceptOnce(requestId, requestHash)
 append(jobId, attemptId, sequence, event)
 terminalTransition(expectedState, outcome)
}
class "recovery.mjs" as recovery {
 interruptUnfinishedOnRestart()
 explicitResume(SessionRef, request)
}
class "JobRequest" as request <<data>> {
 requestId, callerId, parentIds, workspaceId
 targetAgent, mode, prompt
 requestedModel?, effort?, provider?
}
class "Attempt / SessionRef" as attempt <<data>> {
 jobId, attemptId, cliSessionId?
 executable, version, workspace
 requestedIdentity, observedIdentity?
 state, outcome, artifactHashes
}
class "AgentEvent / EventPage" as event <<data>> {
 jobId, attemptId, sequence, timestamp, type
 payload (credential redacted)
 events[], nextCursor?, highWaterMark
}
bridge --> api : local authenticated IPC
api --> request
api --> store : persist before scheduling
api --> scheduler
api --> events
api --> recovery
api --> process : cancellation
scheduler --> policy
policy --> process : enforceable launch
process --> adapter
implementations ..|> adapter
adapter --> attempt
implementations --> events
implementations --> policy : permission callback
recovery --> scheduler : explicit new attempt
recovery --> store
process --> store : single terminal transition
events --> event
events --> store
legend bottom
All modules, signatures and data types are DESIGN, not existing code.
Added: service/store/scheduler/policies/adapters/recovery.
Modified: MCP facade, Claude invocation, output sanitization.
Replaced: synchronous two-tool lifecycle, fixed timeout/output caps.
Unchanged: external CLI-owned authentication; excluded image helper.
See contracts.md for invariants and phase allocation.
endlegend
@enduml
