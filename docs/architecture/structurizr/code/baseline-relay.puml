@startuml
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam shadowing false
title BASELINE c7338ad: ask-claude-mcp.mjs
class "stdin data callback [255-289]" as input {
 buffer : string
 discarding : boolean
 MAX_LINE_CHARS = 8388608
 parse JSON; discard overlong lines
}
class "MCP plumbing [206-251]" as rpc {
 send(msg)
 reply(id, result)
 handle(msg)
 TOOLS : ask_claude | ask_claude_write
}
class "Executable resolution [23-33]" as resolve {
 resolveClaudeOnWindowsPath()
 CLAUDE_CMD : absolute exe on Windows
}
class "runClaude [87-187]" as run {
 running : process-local counter
 MAX_CONCURRENT = 4
 TIMEOUT_MS = 600000
 MAX_OUTPUT_CHARS = 2097152
 finish(result) : once only
}
class "sanitize [192-202]" as clean {
 strip OSC, CSI, stray controls
 redact private key blocks (best effort)
}
class "node:child_process" as node <<external>> {
 spawn(executable, args, {cwd, stdio})
 ChildProcess.kill(SIGKILL)
}
class "Claude CLI process" as cli <<external>> {
 -p --output-format json
 read options: safe-mode; disallowedTools ...
 read: --strict-mcp-config
 write: --permission-mode acceptEdits
 write: --setting-sources user
}
input --> rpc : parsed request
rpc --> run : tools/call awaits result
run --> resolve : resolved executable
run --> node : spawn, event callbacks, direct-child kill
node --> cli : prompt stdin; JSON stdout
rpc --> clean : sanitize returned text
run --> rpc : {ok, text}
class "stdout JSON-RPC port" as stdout <<stdio>>
rpc --> stdout : send/reply JSON response
note bottom of run
stdout cap checks JavaScript string length.
stderr guard can exceed cap by the final chunk.
No durable jobs, cancellation tool, resume or worktree isolation.
Missing/invalid prompt becomes String(prompt ?? "").
end note
legend bottom
Observed source, not external CLI internals.
Target replaces blocking lifetime and fixed output/time caps.
endlegend
@enduml
