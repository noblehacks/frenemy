@startuml
!pragma layout smetana

set separator none
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Modified
  .Element-RWxlbWVudCxNb2RpZmllZA== {
    BackgroundColor: #92400e;
    LineColor: #662c09;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Replaced
  .Element-RWxlbWVudCxSZXBsYWNlZA== {
    BackgroundColor: #991b1b;
    LineColor: #6b1212;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Unchanged
  .Element-RWxlbWVudCxVbmNoYW5nZWQ= {
    BackgroundColor: #475569;
    LineColor: #313b49;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Relationship,Modified
  .Relationship-UmVsYXRpb25zaGlwLE1vZGlmaWVk {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #92400e;
    FontColor: #92400e;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,Replaced
  .Relationship-UmVsYXRpb25zaGlwLFJlcGxhY2Vk {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #991b1b;
    FontColor: #991b1b;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Element,DeploymentBoundary
  .DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50Qm91bmRhcnk= {
    BackgroundColor: #ffffff;
    LineColor: #64748b;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #334155;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // transparent element for relationships in legend
  .Element-Transparent {
    BackgroundColor: transparent;
    LineColor: transparent;
    FontColor: transparent;
  }
</style>

rectangle "==DeploymentBoundary" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50Qm91bmRhcnk=>>

rectangle "==Modified" <<Element-RWxlbWVudCxNb2RpZmllZA==>>

rectangle "==Replaced" <<Element-RWxlbWVudCxSZXBsYWNlZA==>>

rectangle "==Unchanged" <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>>

rectangle "." <<.Element-Transparent>> as 1
1 --> 1 <<Relationship-UmVsYXRpb25zaGlwLE1vZGlmaWVk>> : "Modified"

rectangle "." <<.Element-Transparent>> as 2
2 --> 2 <<Relationship-UmVsYXRpb25zaGlwLFJlcGxhY2Vk>> : "Replaced"

@enduml