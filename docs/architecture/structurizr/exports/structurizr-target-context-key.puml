@startuml
!pragma layout smetana

set separator none
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Added
  .Element-RWxlbWVudCxBZGRlZA== {
    BackgroundColor: #166534;
    LineColor: #0f4624;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Person,Unchanged
  .Element-RWxlbWVudCxQZXJzb24sVW5jaGFuZ2Vk {
    BackgroundColor: #475569;
    LineColor: #313b49;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Unchanged
  .Element-RWxlbWVudCxVbmNoYW5nZWQ= {
    BackgroundColor: #475569;
    LineColor: #313b49;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Relationship,Added
  .Relationship-UmVsYXRpb25zaGlwLEFkZGVk {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #166534;
    FontColor: #166534;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,Modified
  .Relationship-UmVsYXRpb25zaGlwLE1vZGlmaWVk {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #92400e;
    FontColor: #92400e;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,Unchanged
  .Relationship-UmVsYXRpb25zaGlwLFVuY2hhbmdlZA== {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #475569;
    FontColor: #475569;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // transparent element for relationships in legend
  .Element-Transparent {
    BackgroundColor: transparent;
    LineColor: transparent;
    FontColor: transparent;
  }
</style>

rectangle "==Added" <<Element-RWxlbWVudCxBZGRlZA==>>

person "==Person, Unchanged" <<Element-RWxlbWVudCxQZXJzb24sVW5jaGFuZ2Vk>>

rectangle "==Unchanged" <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>>

rectangle "." <<.Element-Transparent>> as 1
1 --> 1 <<Relationship-UmVsYXRpb25zaGlwLEFkZGVk>> : "Added"

rectangle "." <<.Element-Transparent>> as 2
2 --> 2 <<Relationship-UmVsYXRpb25zaGlwLE1vZGlmaWVk>> : "Modified"

rectangle "." <<.Element-Transparent>> as 3
3 --> 3 <<Relationship-UmVsYXRpb25zaGlwLFVuY2hhbmdlZA==>> : "Unchanged"

@enduml