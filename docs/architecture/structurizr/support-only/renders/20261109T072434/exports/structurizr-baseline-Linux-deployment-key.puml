@startuml
!pragma layout smetana

set separator none
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Unchanged
  .Element-RWxlbWVudCxVbmNoYW5nZWQ= {
    BackgroundColor: #526477;
    LineColor: #394653;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 22;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #4d4d4d;
    FontColor: #4d4d4d;
    FontSize: 18;
    MaximumWidth: 200;
  }
  // Element,Deployment Node
  .DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU= {
    BackgroundColor: #f5f5f5;
    LineColor: #777777;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #333333;
    FontSize: 22;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // transparent element for relationships in legend
  .Element-Transparent {
    BackgroundColor: transparent;
    LineColor: transparent;
    FontColor: transparent;
  }
</style>

rectangle "==Deployment Node" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>>

rectangle "==Unchanged" <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>>

rectangle "." <<.Element-Transparent>> as 1
1 --> 1 <<Relationship-UmVsYXRpb25zaGlw>> : "Relationship"

@enduml