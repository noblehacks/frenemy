person "==Operator\n<size:15>[Person]</size>\n\nUses locally authenticated CLIs and selects explicit read or write delegation." <<Element-RWxlbWVudCxQZXJzb24sVW5jaGFuZ2Vk>> as Operator
rectangle "==Claude Code CLI\n<size:15>[Software System]</size>\n\nExternal client and delegated CLI; existing native authentication and internals." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as ClaudeCodeCLI
rectangle "==Frenemy TARGET DESIGN\n<size:15>[Software System]</size>\n\nExisting relay extended only for Grok Build and Cline CLI support." <<Element-RWxlbWVudCxNb2RpZmllZA==>> as FrenemyTARGETDESIGN
rectangle "==Codex CLI\n<size:15>[Software System]</size>\n\nExternal client and codex exec destination; existing behavior preserved." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as CodexCLI
rectangle "==Grok Build CLI\n<size:15>[Software System]</size>\n\nExternal CLI newly supported by Frenemy; native internals remain external." <<Element-RWxlbWVudCxBZGRlZA==>> as GrokBuildCLI
rectangle "==Cline CLI\n<size:15>[Software System]</size>\n\nExternal CLI newly supported by Frenemy; ACP is an internal invocation detail." <<Element-RWxlbWVudCxBZGRlZA==>> as ClineCLI
rectangle "==Native CLI authentication and providers\n<size:15>[Software System]</size>\n\nCLIs retain their existing credentials; Frenemy selects supported provider, model and effort inputs without owning external authentication." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as NativeCLIauthenticationandproviders

FrenemyTARGETDESIGN --> ClaudeCodeCLI <<Relationship-UmVsYXRpb25zaGlw>> : "Runs existing Claude invocation\n<size:12>[stdin/stdout]</size>"
FrenemyTARGETDESIGN --> GrokBuildCLI <<Relationship-UmVsYXRpb25zaGlwLEFkZGVk>> : "Runs one prompt with native mode and selector argv; parses the JSON answer\n<size:12>[Native CLI / stdout]</size>"
FrenemyTARGETDESIGN --> ClineCLI <<Relationship-UmVsYXRpb25zaGlwLEFkZGVk>> : "Runs one prompt with child-only CLINE_PROVIDER/CLINE_MODEL, --thinking, and native permission responses\n<size:12>[ACP stdio]</size>"
GrokBuildCLI --> FrenemyTARGETDESIGN <<Relationship-UmVsYXRpb25zaGlwLEFkZGVk>> : "Reads prompt file argument\n<size:12>[Filesystem]</size>"
FrenemyTARGETDESIGN --> CodexCLI <<Relationship-UmVsYXRpb25zaGlw>> : "Retains existing registration\n<size:12>[TOML]</size>"
ClaudeCodeCLI --> FrenemyTARGETDESIGN <<Relationship-UmVsYXRpb25zaGlw>> : "Uses unchanged optional helper\n<size:12>[genimg.sh]</size>"
Operator --> FrenemyTARGETDESIGN <<Relationship-UmVsYXRpb25zaGlw>> : "Uses existing MCP server\n<size:12>[Local CLI]</size>"
ClaudeCodeCLI --> NativeCLIauthenticationandproviders <<Relationship-UmVsYXRpb25zaGlw>> : "Uses existing authentication\n<size:12>[Native CLI]</size>"
CodexCLI --> NativeCLIauthenticationandproviders <<Relationship-UmVsYXRpb25zaGlw>> : "Uses existing authentication\n<size:12>[Native CLI]</size>"
GrokBuildCLI --> NativeCLIauthenticationandproviders <<Relationship-UmVsYXRpb25zaGlwLEFkZGVk>> : "Uses existing authentication\n<size:12>[Native CLI]</size>"
ClineCLI --> NativeCLIauthenticationandproviders <<Relationship-UmVsYXRpb25zaGlwLEFkZGVk>> : "Uses existing authentication\n<size:12>[Native CLI]</size>"
ClaudeCodeCLI --> CodexCLI <<Relationship-UmVsYXRpb25zaGlw>> : "Delegates using existing instructions\n<size:12>[codex exec]</size>"
CodexCLI --> FrenemyTARGETDESIGN <<Relationship-UmVsYXRpb25zaGlwLE1vZGlmaWVk>> : "Calls blocking tools\n<size:12>[stdio MCP]</size>"

@enduml