rectangle "Windows user environment\n<size:15>[Deployment Node: Windows]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as targetWindows.Windowsuserenvironment {
  rectangle "==Blocking agent relay\n<size:15>[Container: Node.js]</size>\n\nExisting ask-claude-mcp.mjs process extended with four calls and validated execution selectors; one answer/error per call, fixed startup cwd." <<Element-RWxlbWVudCxNb2RpZmllZA==>> as targetWindows.Windowsuserenvironment.Blockingagentrelay_1
  rectangle "==Frenemy selector configuration\n<size:15>[Container: JSON / JSON Schema]</size>\n\nProduct-owned frenemy.config.json and frenemy.config.schema.json define optional defaults for Claude, Grok and Cline. Invalid startup configuration fails closed on tool calls." <<Element-RWxlbWVudCxBZGRlZA==>> as targetWindows.Windowsuserenvironment.Frenemyselectorconfiguration_1
  rectangle "==Existing user configuration\n<size:15>[Container: User-owned files]</size>\n\nLegacy relay registration and Claude/Codex instructions." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as targetWindows.Windowsuserenvironment.Existinguserconfiguration_1
  rectangle "==Caller workspace\n<size:15>[Container: Filesystem]</size>\n\nRelay startup directory; explicit write calls may edit files." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as targetWindows.Windowsuserenvironment.Callerworkspace_1
  rectangle "==Retained Windows installer\n<size:15>[Container: PowerShell]</size>\n\ninstall.ps1 unchanged; legacy Claude/Codex setup." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as targetWindows.Windowsuserenvironment.RetainedWindowsinstaller_1
  rectangle "==Windows prompt ACL helper\n<size:15>[Container: PowerShell7 process DESIGN]</size>\n\nFixed Protect-GrokPrompt.ps1 child invoked by native pwsh.exe before writing prompt bytes; Windows only." <<Element-RWxlbWVudCxBZGRlZA==>> as targetWindows.Windowsuserenvironment.WindowspromptACLhelper_1
  rectangle "==Invocation-local Grok prompt\n<size:15>[Container: OS temp filesystem DESIGN]</size>\n\nExclusive protected temp directory/file, finally cleanup; protected residue after uncatchable crash." <<Element-RWxlbWVudCxBZGRlZA==>> as targetWindows.Windowsuserenvironment.InvocationlocalGrokprompt_1
  rectangle "==Claude Code CLI\n<size:15>[Software System]</size>\n\nExternal client and delegated CLI; existing native authentication and internals." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as targetWindows.Windowsuserenvironment.ClaudeCodeCLI_1
  rectangle "==Codex CLI\n<size:15>[Software System]</size>\n\nExternal client and codex exec destination; existing behavior preserved." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as targetWindows.Windowsuserenvironment.CodexCLI_1
  rectangle "==Grok Build CLI\n<size:15>[Software System]</size>\n\nExternal CLI newly supported by Frenemy; native internals remain external." <<Element-RWxlbWVudCxBZGRlZA==>> as targetWindows.Windowsuserenvironment.GrokBuildCLI_1
  rectangle "==Cline CLI\n<size:15>[Software System]</size>\n\nExternal CLI newly supported by Frenemy; ACP is an internal invocation detail." <<Element-RWxlbWVudCxBZGRlZA==>> as targetWindows.Windowsuserenvironment.ClineCLI_1
}

