rectangle "==Cline CLI\n<size:15>[Software System]</size>\n\nExternal CLI newly supported by Frenemy; ACP is an internal invocation detail." <<Element-RWxlbWVudCxBZGRlZA==>> as ClineCLI

rectangle "Frenemy TARGET DESIGN\n<size:15>[Software System]</size>" <<Boundary-RnJlbmVteSBUQVJHRVQgREVTSUdO>> {
  rectangle "Blocking agent relay\n<size:15>[Container: Node.js]</size>" <<Boundary-QmxvY2tpbmcgYWdlbnQgcmVsYXk=>> {
    rectangle "==Line framing\n<size:15>[Component: JavaScript]</size>\n\nExisting stdin callback, buffer and discarding behavior retained." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as FrenemyTARGETDESIGN.Blockingagentrelay.Lineframing
    rectangle "==MCP dispatcher\n<size:15>[Component: JavaScript]</size>\n\nExisting handle/TOOLS/send/reply plus four Grok/Cline read/write tools whose inputs may include supported selectors." <<Element-RWxlbWVudCxNb2RpZmllZA==>> as FrenemyTARGETDESIGN.Blockingagentrelay.MCPdispatcher
    rectangle "==Configuration and selector resolution\n<size:15>[Component: JavaScript]</size>\n\nLoads and validates the product-owned JSON configuration at startup; resolves caller input over per-agent defaults and rejects invalid values before launch." <<Element-RWxlbWVudCxBZGRlZA==>> as FrenemyTARGETDESIGN.Blockingagentrelay.Configurationandselectorresolution
    rectangle "==Claude invocation\n<size:15>[Component: JavaScript]</size>\n\nExisting runClaude and Windows resolution, limits and error behavior retained." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as FrenemyTARGETDESIGN.Blockingagentrelay.Claudeinvocation
    rectangle "==Grok invocation\n<size:15>[Component: JavaScript]</size>\n\nOne headless prompt with native read/write flags; map model and effort to native argv; parse JSON answer." <<Element-RWxlbWVudCxBZGRlZA==>> as FrenemyTARGETDESIGN.Blockingagentrelay.Grokinvocation
    rectangle "==Cline invocation\n<size:15>[Component: JavaScript]</size>\n\nOne ACP prompt with native permission responses; map provider/model into a child-only environment and effort to --thinking without mutating the parent environment." <<Element-RWxlbWVudCxBZGRlZA==>> as FrenemyTARGETDESIGN.Blockingagentrelay.Clineinvocation
    rectangle "==Response sanitization\n<size:15>[Component: JavaScript]</size>\n\nExisting sanitize; best-effort terminal/private-key cleanup, not comprehensive secret protection." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as FrenemyTARGETDESIGN.Blockingagentrelay.Responsesanitization
  }

  rectangle "==Frenemy selector configuration\n<size:15>[Container: JSON / JSON Schema]</size>\n\nProduct-owned frenemy.config.json and frenemy.config.schema.json define optional defaults for Claude, Grok and Cline. Invalid startup configuration fails closed on tool calls." <<Element-RWxlbWVudCxBZGRlZA==>> as FrenemyTARGETDESIGN.Frenemyselectorconfiguration
  rectangle "==Caller workspace\n<size:15>[Container: Filesystem]</size>\n\nRelay startup directory; explicit write calls may edit files." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as FrenemyTARGETDESIGN.Callerworkspace
  rectangle "==Invocation-local Grok prompt\n<size:15>[Container: OS temp filesystem DESIGN]</size>\n\nExclusive protected temp directory/file, finally cleanup; protected residue after uncatchable crash." <<Element-RWxlbWVudCxBZGRlZA==>> as FrenemyTARGETDESIGN.InvocationlocalGrokprompt
  rectangle "==Windows prompt ACL helper\n<size:15>[Container: PowerShell7 process DESIGN]</size>\n\nFixed Protect-GrokPrompt.ps1 child invoked by native pwsh.exe before writing prompt bytes; Windows only." <<Element-RWxlbWVudCxBZGRlZA==>> as FrenemyTARGETDESIGN.WindowspromptACLhelper
}

