rectangle "==Codex CLI\n<size:15>[Software System]</size>\n\nExternal client and codex exec destination; existing behavior preserved." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as CodexCLI
rectangle "==Grok Build CLI\n<size:15>[Software System]</size>\n\nExternal CLI newly supported by Frenemy; native internals remain external." <<Element-RWxlbWVudCxBZGRlZA==>> as GrokBuildCLI

rectangle "Frenemy TARGET DESIGN\n<size:15>[Software System]</size>" <<Boundary-RnJlbmVteSBUQVJHRVQgREVTSUdO>> {
  rectangle "Blocking agent relay\n<size:15>[Container: Node.js]</size>" <<Boundary-QmxvY2tpbmcgYWdlbnQgcmVsYXk=>> {
    rectangle "==Line framing\n<size:15>[Component: JavaScript]</size>\n\nExisting stdin callback, buffer and discarding behavior retained." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as FrenemyTARGETDESIGN.Blockingagentrelay.Lineframing
    rectangle "==MCP dispatcher\n<size:15>[Component: JavaScript]</size>\n\nExisting handle/TOOLS/send/reply plus four Grok/Cline read/write tools whose inputs may include supported selectors." <<Element-RWxlbWVudCxNb2RpZmllZA==>> as FrenemyTARGETDESIGN.Blockingagentrelay.MCPdispatcher
    rectangle "==Configuration and selector resolution\n<size:15>[Component: JavaScript]</size>\n\nLoads and validates the product-owned JSON configuration at startup; resolves caller input over per-agent defaults and rejects invalid values before launch." <<Element-RWxlbWVudCxBZGRlZA==>> as FrenemyTARGETDESIGN.Blockingagentrelay.Configurationandselectorresolution
    rectangle "==Grok invocation\n<size:15>[Component: JavaScript]</size>\n\nOne headless prompt with native read/write flags; map model and effort to native argv; parse JSON answer." <<Element-RWxlbWVudCxBZGRlZA==>> as FrenemyTARGETDESIGN.Blockingagentrelay.Grokinvocation
    rectangle "==Response sanitization\n<size:15>[Component: JavaScript]</size>\n\nExisting sanitize; best-effort terminal/private-key cleanup, not comprehensive secret protection." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as FrenemyTARGETDESIGN.Blockingagentrelay.Responsesanitization
  }

  rectangle "==Frenemy selector configuration\n<size:15>[Container: JSON / JSON Schema]</size>\n\nProduct-owned frenemy.config.json and frenemy.config.schema.json define optional defaults for Claude, Grok and Cline. Invalid startup configuration fails closed on tool calls." <<Element-RWxlbWVudCxBZGRlZA==>> as FrenemyTARGETDESIGN.Frenemyselectorconfiguration
  rectangle "==Invocation-local Grok prompt\n<size:15>[Container: OS temp filesystem DESIGN]</size>\n\nExclusive protected temp directory/file, finally cleanup; protected residue after uncatchable crash." <<Element-RWxlbWVudCxBZGRlZA==>> as FrenemyTARGETDESIGN.InvocationlocalGrokprompt
  rectangle "==Windows prompt ACL helper\n<size:15>[Container: PowerShell7 process DESIGN]</size>\n\nFixed Protect-GrokPrompt.ps1 child invoked by native pwsh.exe before writing prompt bytes; Windows only." <<Element-RWxlbWVudCxBZGRlZA==>> as FrenemyTARGETDESIGN.WindowspromptACLhelper
}

rectangle "==Codex CLI\n<size:15>[Software System]</size>\n\nExternal client and codex exec destination; existing behavior preserved." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as CodexCLI
rectangle "==Grok Build CLI\n<size:15>[Software System]</size>\n\nExternal CLI newly supported by Frenemy; native internals remain external." <<Element-RWxlbWVudCxBZGRlZA==>> as GrokBuildCLI
rectangle "==Frenemy selector configuration\n<size:15>[Container: JSON / JSON Schema]</size>\n\nProduct-owned frenemy.config.json and frenemy.config.schema.json define optional defaults for Claude, Grok and Cline. Invalid startup configuration fails closed on tool calls." <<Element-RWxlbWVudCxBZGRlZA==>> as FrenemyTARGETDESIGN.Frenemyselectorconfiguration
rectangle "==Invocation-local Grok prompt\n<size:15>[Container: OS temp filesystem DESIGN]</size>\n\nExclusive protected temp directory/file, finally cleanup; protected residue after uncatchable crash." <<Element-RWxlbWVudCxBZGRlZA==>> as FrenemyTARGETDESIGN.InvocationlocalGrokprompt
rectangle "==Windows prompt ACL helper\n<size:15>[Container: PowerShell7 process DESIGN]</size>\n\nFixed Protect-GrokPrompt.ps1 child invoked by native pwsh.exe before writing prompt bytes; Windows only." <<Element-RWxlbWVudCxBZGRlZA==>> as FrenemyTARGETDESIGN.WindowspromptACLhelper

CodexCLI --> FrenemyTARGETDESIGN.Blockingagentrelay.Lineframing <<Relationship-UmVsYXRpb25zaGlwLE1vZGlmaWVk>> : "1: Submit prompt to selected Grok tool\n<size:12>[stdio MCP]</size>"
FrenemyTARGETDESIGN.Blockingagentrelay.Lineframing --> FrenemyTARGETDESIGN.Blockingagentrelay.MCPdispatcher <<Relationship-UmVsYXRpb25zaGlw>> : "2: Dispatch\n<size:12>[In-process]</size>"
FrenemyTARGETDESIGN.Blockingagentrelay.MCPdispatcher --> FrenemyTARGETDESIGN.Blockingagentrelay.Configurationandselectorresolution <<Relationship-UmVsYXRpb25zaGlwLEFkZGVk>> : "3: Validate caller selectors and resolve caller over Grok defaults\n<size:12>[In-process]</size>"
FrenemyTARGETDESIGN.Blockingagentrelay.Configurationandselectorresolution --> FrenemyTARGETDESIGN.Frenemyselectorconfiguration <<Relationship-UmVsYXRpb25zaGlwLEFkZGVk>> : "4: Read validated startup defaults\n<size:12>[Filesystem / JSON]</size>"
FrenemyTARGETDESIGN.Blockingagentrelay.Configurationandselectorresolution --> FrenemyTARGETDESIGN.Blockingagentrelay.Grokinvocation <<Relationship-UmVsYXRpb25zaGlwLEFkZGVk>> : "5: Supply model and effort\n<size:12>[In-process]</size>"
FrenemyTARGETDESIGN.Blockingagentrelay.MCPdispatcher --> FrenemyTARGETDESIGN.Blockingagentrelay.Grokinvocation <<Relationship-UmVsYXRpb25zaGlwLEFkZGVk>> : "6: Dispatch under the shared relay deadline and capacity\n<size:12>[In-process]</size>"
FrenemyTARGETDESIGN.Blockingagentrelay.Grokinvocation --> FrenemyTARGETDESIGN.WindowspromptACLhelper <<Relationship-UmVsYXRpb25zaGlwLEFkZGVk>> : "7: Windows: protect unique temp directory before prompt bytes\n<size:12>[pwsh.exe child / fixed script]</size>"
FrenemyTARGETDESIGN.Blockingagentrelay.Grokinvocation --> FrenemyTARGETDESIGN.InvocationlocalGrokprompt <<Relationship-UmVsYXRpb25zaGlwLEFkZGVk>> : "8: Exclusive protected UTF-8 prompt write; Linux0700/0600\n<size:12>[Filesystem]</size>"
FrenemyTARGETDESIGN.Blockingagentrelay.Grokinvocation --> GrokBuildCLI <<Relationship-UmVsYXRpb25zaGlwLEFkZGVk>> : "9: Submit prompt file with qualified native access mode, --model and --reasoning-effort\n<size:12>[Native CLI / stdout]</size>"
FrenemyTARGETDESIGN.Blockingagentrelay.Grokinvocation --> FrenemyTARGETDESIGN.InvocationlocalGrokprompt <<Relationship-UmVsYXRpb25zaGlwLEFkZGVk>> : "10: Finally cleanup on success and every caught failure\n<size:12>[Filesystem]</size>"
FrenemyTARGETDESIGN.Blockingagentrelay.MCPdispatcher --> FrenemyTARGETDESIGN.Blockingagentrelay.Responsesanitization <<Relationship-UmVsYXRpb25zaGlw>> : "11: Clean final answer/error before MCP response\n<size:12>[In-process]</size>"

@enduml