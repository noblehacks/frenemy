rectangle "Linux user environment\n<size:15>[Deployment Node: Linux]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as targetLinux.Linuxuserenvironment {
  rectangle "==Blocking agent relay\n<size:15>[Container: Node.js]</size>\n\nExisting ask-claude-mcp.mjs process extended with four calls and validated execution selectors; one answer/error per call, fixed startup cwd." <<Element-RWxlbWVudCxNb2RpZmllZA==>> as targetLinux.Linuxuserenvironment.Blockingagentrelay_1
  rectangle "==Frenemy selector configuration\n<size:15>[Container: JSON / JSON Schema]</size>\n\nProduct-owned frenemy.config.json and frenemy.config.schema.json define optional defaults for Claude, Grok and Cline. Invalid startup configuration fails closed on tool calls." <<Element-RWxlbWVudCxBZGRlZA==>> as targetLinux.Linuxuserenvironment.Frenemyselectorconfiguration_1
  rectangle "==Existing user configuration\n<size:15>[Container: User-owned files]</size>\n\nLegacy relay registration and Claude/Codex instructions." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as targetLinux.Linuxuserenvironment.Existinguserconfiguration_1
  rectangle "==Caller workspace\n<size:15>[Container: Filesystem]</size>\n\nRelay startup directory; explicit write calls may edit files." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as targetLinux.Linuxuserenvironment.Callerworkspace_1
  rectangle "==Retained Mac/Linux installer\n<size:15>[Container: Bash existing source]</size>\n\ninstall.sh unchanged; legacy setup and optional helper." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as targetLinux.Linuxuserenvironment.RetainedMacLinuxinstaller_1
  rectangle "==Optional image helper\n<size:15>[Container: Bash (existing source)]</size>\n\nExisting genimg.sh unchanged; changes excluded." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as targetLinux.Linuxuserenvironment.Optionalimagehelper_1
  rectangle "==Requested image output\n<size:15>[Container: Filesystem]</size>\n\nExisting user-selected image output path." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as targetLinux.Linuxuserenvironment.Requestedimageoutput_1
  rectangle "==Invocation-local Grok prompt\n<size:15>[Container: OS temp filesystem DESIGN]</size>\n\nExclusive protected temp directory/file, finally cleanup; protected residue after uncatchable crash." <<Element-RWxlbWVudCxBZGRlZA==>> as targetLinux.Linuxuserenvironment.InvocationlocalGrokprompt_1
  rectangle "==Claude Code CLI\n<size:15>[Software System]</size>\n\nExternal client and delegated CLI; existing native authentication and internals." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as targetLinux.Linuxuserenvironment.ClaudeCodeCLI_1
  rectangle "==Codex CLI\n<size:15>[Software System]</size>\n\nExternal client and codex exec destination; existing behavior preserved." <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>> as targetLinux.Linuxuserenvironment.CodexCLI_1
  rectangle "==Grok Build CLI\n<size:15>[Software System]</size>\n\nExternal CLI newly supported by Frenemy; native internals remain external." <<Element-RWxlbWVudCxBZGRlZA==>> as targetLinux.Linuxuserenvironment.GrokBuildCLI_1
  rectangle "==Cline CLI\n<size:15>[Software System]</size>\n\nExternal CLI newly supported by Frenemy; ACP is an internal invocation detail." <<Element-RWxlbWVudCxBZGRlZA==>> as targetLinux.Linuxuserenvironment.ClineCLI_1
}

