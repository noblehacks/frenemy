@startuml
!pragma layout smetana

set separator none
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Added
  .Element-RWxlbWVudCxBZGRlZA== {
    BackgroundColor: #176b3a;
    LineColor: #104a28;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 22;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Modified
  .Element-RWxlbWVudCxNb2RpZmllZA== {
    BackgroundColor: #865a22;
    LineColor: #5d3e17;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 22;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Unchanged
  .Element-RWxlbWVudCxVbmNoYW5nZWQ= {
    BackgroundColor: #526477;
    LineColor: #394653;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 22;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #4d4d4d;
    FontColor: #4d4d4d;
    FontSize: 18;
    MaximumWidth: 200;
  }
  // Relationship,Added
  .Relationship-UmVsYXRpb25zaGlwLEFkZGVk {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #176b3a;
    FontColor: #176b3a;
    FontSize: 18;
    MaximumWidth: 200;
  }
  // Relationship,Modified
  .Relationship-UmVsYXRpb25zaGlwLE1vZGlmaWVk {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #865a22;
    FontColor: #865a22;
    FontSize: 18;
    MaximumWidth: 200;
  }
  // Element,Deployment Node
  .DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU= {
    BackgroundColor: #f5f5f5;
    LineColor: #777777;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #333333;
    FontSize: 22;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // transparent element for relationships in legend
  .Element-Transparent {
    BackgroundColor: transparent;
    LineColor: transparent;
    FontColor: transparent;
  }
</style>

rectangle "==Deployment Node" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>>

rectangle "==Added" <<Element-RWxlbWVudCxBZGRlZA==>>

rectangle "==Modified" <<Element-RWxlbWVudCxNb2RpZmllZA==>>

rectangle "==Unchanged" <<Element-RWxlbWVudCxVbmNoYW5nZWQ=>>

rectangle "." <<.Element-Transparent>> as 1
1 --> 1 <<Relationship-UmVsYXRpb25zaGlw>> : "Relationship"

rectangle "." <<.Element-Transparent>> as 2
2 --> 2 <<Relationship-UmVsYXRpb25zaGlwLEFkZGVk>> : "Added"

rectangle "." <<.Element-Transparent>> as 3
3 --> 3 <<Relationship-UmVsYXRpb25zaGlwLE1vZGlmaWVk>> : "Modified"

@enduml